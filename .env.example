# ============================================================================
# pons fee-claimer — copy to .env and fill in. NEVER commit .env.
# ============================================================================

# Claim wallet key. Must be the wallet that collectFees pays out to
# (feeRedirects[token], falling back to the token deployer). Any throwaway
# key works for DRY_RUN. With or without 0x prefix.
PRIVATE_KEY=

# Your pons launchpad token's contract address on Robinhood Chain.
TOKEN_ADDRESS=

# Where the token-side fees (and TREASURY_PCT% of the ETH) go. Required.
TREASURY_WALLET=

# Where the rest of the ETH goes (kumo agent hot wallet). Required while
# TREASURY_PCT < 100.
KUMO_WALLET=

# % of forwarded ETH that goes to TREASURY_WALLET; remainder goes to
# KUMO_WALLET. Default 0 = everything flows to kumo.
TREASURY_PCT=0

# DRY_RUN=true (default): every read runs, every send is logged instead of
# sent. Set to false only after the DRY_RUN output looks right.
DRY_RUN=true

# Thresholds (ETH).
CLAIM_MIN_ETH=0.01        # claim only when the NET WETH share is at least this
GAS_RESERVE_ETH=0.02      # always keep this much ETH in the hot wallet
MAX_FORWARD_ETH=1         # per-cycle forward cap (fat-finger guard)
FORWARD_MIN_ETH=0.001     # skip dust-sized forwards

# Cycle cadence, minutes.
INTERVAL_MINUTES=10

# --- Rarely changed -----------------------------------------------------

# RPC_URL=https://rpc.mainnet.chain.robinhood.com
# EXPLORER_BASE=https://robinhoodchain.blockscout.com
# PORT=8787

# Skip the current->legacy locker auto-probe and use this locker directly.
# LOCKER_ADDRESS=

# WETH=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73

# Gas policy.
# MAX_FEE_GWEI=50
# MAX_PRIORITY_GWEI=2
# GAS_BUMP_PCT=25
# TX_WAIT_MS=90000
