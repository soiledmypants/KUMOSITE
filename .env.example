# ============================================================================
# kumo monorepo env — copy to .env at the repo root (the agent reads .env from
# apps/agent/ first, then falls back to this root file). NEVER commit .env.
# This file supersedes the old kumo-agent / ops-panel / KUMOSITE env examples.
# ============================================================================

# ---- hot wallet ----------------------------------------------------------------
# kumo's hands: holds fee ETH, buys the round stock, sends the airdrops.
# NEVER commit the real one. Set it here locally and in the Render dashboard.
PRIVATE_KEY=

# pons claim wallet (must derive the on-chain fee recipient: feeRedirects[token]
# || deployer). Unset -> PRIVATE_KEY claims for itself.
# CLAIMER_PRIVATE_KEY=

# admin key for mutating routes (POST /watch, /trade/execute, /admin/*) and the
# site's /admin panel (entered client-side, held in memory only).
KUMO_ADMIN_KEY=change-me

# neon postgres url -> durable storage. empty -> local sqlite in apps/agent/data
DATABASE_URL=

# ---- modes ----------------------------------------------------------------------
# serve everything fake (no rpc needed) — full frontend dev with zero chain access
KUMO_MOCK=false
# true -> scheduled keeper cycles PLAN rounds but never send (launch rehearsal)
KEEPER_DRY_RUN=false

# ---- server -----------------------------------------------------------------------
PORT=8787
# production: https://api.imkumoagent.com (custom domain on the render service)
PUBLIC_URL=http://localhost:8787
# production: https://imkumoagent.com,https://www.imkumoagent.com
CORS_ORIGINS=*

# ---- chain (verified defaults live in packages/shared — override only if infra changes)
# RPC_URL=https://rpc.mainnet.chain.robinhood.com
# EXPLORER_BASE=https://robinhoodchain.blockscout.com

# ---- llm (powers /chat + tweet composer; falls back to rule-based lines) -------
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# ---- trading (execute is OFF by default; quotes always work) --------------------
TRADING_ENABLED=false
TRADE_MAX_ETH=0.05
TRADE_DAILY_MAX_ETH=0.25
SLIPPAGE_PCT=1

# ---- payout keeper — rapid rotating cycle (inactive until STAKING_ADDRESS or
# KUMO_TOKEN is set) ---------------------------------------------------------------
KUMO_TOKEN=
STAKING_ADDRESS=
# STAKING_DEPLOY_BLOCK=
KUMO_EPOCH_STOCK=auto
CYCLE_MINUTES=10
DISTRIBUTE_MIN_ETH=0.05
PER_RECIPIENT_MIN_USD=0.25
GAS_RESERVE_ETH=0.02
MAX_IMPACT_PCT=2

# connected-agent rewards (phase 2 — all OFF by default, behavior identical to today)
BOOST_ENABLED=false
BOOST_PCT=10
# AGENT_REWARD_MODE=            # unset (stakers-only) | boost | pool | both
# AGENT_POOL_PCT=10             # % of each round's bought stock, hard-capped at 25
# AGENT_LIVENESS_HOURS=24
# AGENT_MIN_REP=0.55
# AGENT_REQUIRE_STAKE=true
# AGENT_MIN_HOLD=0
# MAX_AGENT_SHARE_PCT=20

# ---- pons fee claiming (ported from ops-panel; the keeper's ETH source) ---------
CLAIM_ENABLED=false
CLAIM_DRY_RUN=true
CLAIM_INTERVAL_MINUTES=10
CLAIM_MIN_ETH=0.01
CLAIM_GAS_RESERVE_ETH=0.005
CLAIM_MAX_FORWARD_ETH=1
# CLAIM_TREASURY_WALLET=
CLAIM_TREASURY_PCT=0
# PONS_LOCKER=auto

# ---- stock tokens ----------------------------------------------------------------
# STOCK_TOKENS=NVDA:0xd0601ce157db5bdc3162bbac2a2c8af5320d9eec
# CHAINLINK_FEEDS=

# ---- twitter persona (inactive until credentials set) ---------------------------
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_DRY_RUN=true
KILLSWITCH=false
TWITTER_ALLOWED_LINK_HOSTS=
TWITTER_MAX_TWEETS_PER_DAY=30
TWITTER_MAX_REPLIES_PER_DAY=20
TWITTER_MAX_REPLIES_PER_USER_HOUR=1
TWITTER_MENTIONS_POLL_MS=120000
TWITTER_HEARTBEAT_MS=14400000
TWITTER_EVENT_COOLDOWN_MS=900000

# ---- site (vite) ------------------------------------------------------------------
# dev default is set by the root dev script; override to point the site elsewhere
# VITE_KUMO_API=http://localhost:8787
