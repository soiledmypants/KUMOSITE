# ---- kumo agent config -------------------------------------------------------
# every value is optional except PRIVATE_KEY when you want kumo to have hands
# (trading, staking keeper, erc-8004 registration). read-only + mock modes work
# without it.

# hot wallet key. NEVER commit the real one.
PRIVATE_KEY=

# admin key for mutating routes (POST /watch, /trade/execute, /admin/*)
KUMO_ADMIN_KEY=change-me

# neon postgres url -> durable storage. empty -> local sqlite in ./data
DATABASE_URL=

# optional: claude-powered /chat (falls back to rule-based kumo voice without it)
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-4-5-20251001

# serve everything fake (no rpc needed) — perfect for frontend dev
KUMO_MOCK=false

# server
PORT=8787
# production: https://api.imkumoagent.com (custom domain on the render service)
PUBLIC_URL=http://localhost:8787
# production: https://imkumoagent.com,https://www.imkumoagent.com
# dev: add http://localhost:8080 (or your local site port) to the list
CORS_ORIGINS=*

# chain (verified defaults baked in; override only if infra changes)
RPC_URL=https://rpc.mainnet.chain.robinhood.com
EXPLORER_BASE=https://robinhoodchain.blockscout.com

# trading (execute is OFF by default; quotes always work)
TRADING_ENABLED=false
TRADE_MAX_ETH=0.05
TRADE_DAILY_MAX_ETH=0.25
SLIPPAGE_PCT=1

# staking keeper (inactive until both are set)
KUMO_TOKEN=
STAKING_ADDRESS=
KUMO_EPOCH_STOCK=auto
MIN_FUND_ETH=0.05
GAS_RESERVE_ETH=0.02
MAX_IMPACT_PCT=2

# stock tokens kumo watches: "SYM:0xaddr,SYM:0xaddr" (NVDA verified default baked in)
# STOCK_TOKENS=NVDA:0xd0601ce157db5bdc3162bbac2a2c8af5320d9eec
# optional chainlink AggregatorV3 feeds per symbol: "NVDA:0xfeed"
# CHAINLINK_FEEDS=

# ---- twitter persona -----------------------------------------------------------
# fully autonomous febu-style account. inactive until credentials are set.
# oauth 1.0a user context (read + write) from developer.x.com
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# safety switches
# DRY_RUN=true (default): compose + guardrail + log, never actually post
TWITTER_DRY_RUN=true
# KILLSWITCH=true halts ALL posting instantly (checked before every post; on
# render an env-var change restarts the service in seconds, no rebuild)
KILLSWITCH=false

# links: ONLY these hosts may ever appear in a tweet (our own site). empty = no links at all
# production: imkumoagent.com
TWITTER_ALLOWED_LINK_HOSTS=

# limits + cadence
TWITTER_MAX_TWEETS_PER_DAY=30
TWITTER_MAX_REPLIES_PER_DAY=20
TWITTER_MAX_REPLIES_PER_USER_HOUR=1
TWITTER_MENTIONS_POLL_MS=120000
TWITTER_HEARTBEAT_MS=14400000
TWITTER_EVENT_COOLDOWN_MS=900000
