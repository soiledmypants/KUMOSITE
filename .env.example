# ============================================================================
# ops-panel — copy to .env and fill in. NEVER commit .env.
# ============================================================================

# --- panel / global ---------------------------------------------------------

# Panel login password. REQUIRED — the server refuses to boot without it.
ADMIN_PASSWORD=

# Encrypts keys imported through the panel (AES-256-GCM). Required only if you
# use the key vault. Losing it makes imported keys unrecoverable.
KEY_SECRET=

# MASTER dry-run switch. true (default) = every action logs instead of sends,
# regardless of panel buttons. Flip to false only after dry output looks right.
DRY_RUN=true

# Where journal.jsonl / holders-*.db / keys.json live. On Railway: /data (volume).
# DATA_DIR=data

# SESSION_TTL_HOURS=24
# PORT=8787
# PUBLIC_STATS=false

# --- pons project (projects.json interpolates these) -------------------------

# Claim wallet key — must derive the wallet that collectFees pays out to
# (feeRedirects[token] || deployer). Any throwaway key works for DRY_RUN.
PRIVATE_KEY=

# Your pons launchpad token's contract address.
TOKEN_ADDRESS=

# Token-side fees (and TREASURY_PCT% of ETH) go here.
TREASURY_WALLET=

# The rest of the ETH goes here (kumo agent hot wallet).
KUMO_WALLET=

# Block your token launched at — first holder scan starts here (Blockscout
# token page -> creation tx). Leave unset to scan from genesis (slow).
HOLDERS_START_BLOCK=

# --- gas policy (all projects) ------------------------------------------------
# MAX_FEE_GWEI=50
# MAX_PRIORITY_GWEI=2
# GAS_BUMP_PCT=25
# TX_WAIT_MS=90000
