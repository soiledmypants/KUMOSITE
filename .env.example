# ---- kumo agent config -------------------------------------------------------
# every value is optional except PRIVATE_KEY when you want kumo to have hands
# (trading, staking keeper, erc-8004 registration). read-only + mock modes work
# without it.

# hot wallet key. NEVER commit the real one.
PRIVATE_KEY=

# admin key for mutating routes (POST /watch, /trade/execute, /admin/*)
KUMO_ADMIN_KEY=change-me

# neon postgres url -> durable storage. empty -> local sqlite in ./data
DATABASE_URL=

# optional: claude-powered /chat (falls back to rule-based kumo voice without it)
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-4-5-20251001

# serve everything fake (no rpc needed) — perfect for frontend dev
KUMO_MOCK=false

# server
PORT=8787
PUBLIC_URL=http://localhost:8787
CORS_ORIGINS=*

# chain (verified defaults baked in; override only if infra changes)
RPC_URL=https://rpc.mainnet.chain.robinhood.com
EXPLORER_BASE=https://robinhoodchain.blockscout.com

# trading (execute is OFF by default; quotes always work)
TRADING_ENABLED=false
TRADE_MAX_ETH=0.05
TRADE_DAILY_MAX_ETH=0.25
SLIPPAGE_PCT=1

# staking keeper (inactive until both are set)
KUMO_TOKEN=
STAKING_ADDRESS=
KUMO_EPOCH_STOCK=auto
MIN_FUND_ETH=0.05
GAS_RESERVE_ETH=0.02
MAX_IMPACT_PCT=2

# stock tokens kumo watches: "SYM:0xaddr,SYM:0xaddr" (NVDA verified default baked in)
# STOCK_TOKENS=NVDA:0xd0601ce157db5bdc3162bbac2a2c8af5320d9eec
# optional chainlink AggregatorV3 feeds per symbol: "NVDA:0xfeed"
# CHAINLINK_FEEDS=
