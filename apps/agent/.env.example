# ---- kumo agent config -------------------------------------------------------
# every value is optional except PRIVATE_KEY when you want kumo to have hands
# (trading, staking keeper, erc-8004 registration). read-only + mock modes work
# without it.

# hot wallet key. NEVER commit the real one.
PRIVATE_KEY=

# admin key for mutating routes (POST /watch, /trade/execute, /admin/*)
KUMO_ADMIN_KEY=change-me

# neon postgres url -> durable storage. empty -> local sqlite in ./data
DATABASE_URL=

# ---- llm provider (powers /chat + the tweet composer) -------------------------
# "anthropic" (default) or "openai". missing key or failed call always falls
# back to rule-based kumo lines — never a crash or blank reply.
LLM_PROVIDER=anthropic

# anthropic mode
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-4-5-20251001

# openai mode (also any openai-compatible endpoint via LLM_BASE_URL:
# ollama, groq, openrouter, a local proxy...)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# serve everything fake (no rpc needed) — perfect for frontend dev
KUMO_MOCK=false

# server
PORT=8787
# production: https://api.imkumoagent.com (custom domain on the render service)
PUBLIC_URL=http://localhost:8787
# production: https://imkumoagent.com,https://www.imkumoagent.com
# dev: add http://localhost:8080 (or your local site port) to the list
CORS_ORIGINS=*

# chain (verified defaults baked in; override only if infra changes)
RPC_URL=https://rpc.mainnet.chain.robinhood.com
EXPLORER_BASE=https://robinhoodchain.blockscout.com

# trading (execute is OFF by default; quotes always work)
TRADING_ENABLED=false
TRADE_MAX_ETH=0.05
TRADE_DAILY_MAX_ETH=0.25
SLIPPAGE_PCT=1

# payout keeper — rapid rotating cycle (inactive until STAKING_ADDRESS or KUMO_TOKEN is set)
KUMO_TOKEN=
STAKING_ADDRESS=
# STAKING_DEPLOY_BLOCK=            # speeds up the first staker scan
KUMO_EPOCH_STOCK=auto              # fixed stock address to override the per-round ta pick
CYCLE_MINUTES=10                   # keeper cadence: sweep -> maybe payout round
DISTRIBUTE_MIN_ETH=0.05            # below this kumo journals "saving up" and waits
PER_RECIPIENT_MIN_USD=0.25         # dust guard: shares below this skip-and-accrue
BOOST_ENABLED=false                # connected-agent boost is designed in but ships OFF
BOOST_PCT=10                       # boost size when BOOST_ENABLED=true
GAS_RESERVE_ETH=0.02
MAX_IMPACT_PCT=2
KEEPER_DRY_RUN=false               # true -> scheduled cycles PLAN a round but never send.
                                   # one-off plan any time: POST /admin/keeper/dry-run (admin key)

# ---- pons fee claiming (ported from ops-panel) --------------------------------
# claims $KUMO creator fees from the pons locker and forwards ETH to the hot
# wallet. inactive until KUMO_TOKEN is set and CLAIM_ENABLED=true.
# collectFees always pays feeRedirects[token] || deployer no matter who calls,
# so the claimer key must derive that wallet — verified every cycle.
CLAIM_ENABLED=false
CLAIM_DRY_RUN=true                 # plan + log only until you flip it
# CLAIMER_PRIVATE_KEY=             # deployer wallet key; unset -> PRIVATE_KEY claims
CLAIM_INTERVAL_MINUTES=10
CLAIM_MIN_ETH=0.01
CLAIM_GAS_RESERVE_ETH=0.005
CLAIM_MAX_FORWARD_ETH=1
# CLAIM_TREASURY_WALLET=           # optional: claimed $KUMO + CLAIM_TREASURY_PCT% of ETH go here
CLAIM_TREASURY_PCT=0
# PONS_LOCKER=auto                 # auto = probe current->legacy verified lockers

# stock tokens kumo watches: "SYM:0xaddr,SYM:0xaddr" (NVDA verified default baked in)
# STOCK_TOKENS=NVDA:0xd0601ce157db5bdc3162bbac2a2c8af5320d9eec
# optional chainlink AggregatorV3 feeds per symbol: "NVDA:0xfeed"
# CHAINLINK_FEEDS=

# ---- twitter persona -----------------------------------------------------------
# fully autonomous febu-style account. inactive until credentials are set.
# oauth 1.0a user context (read + write) from developer.x.com
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# safety switches
# DRY_RUN=true (default): compose + guardrail + log, never actually post
TWITTER_DRY_RUN=true
# KILLSWITCH=true halts ALL posting instantly (checked before every post; on
# render an env-var change restarts the service in seconds, no rebuild)
KILLSWITCH=false

# links: ONLY these hosts may ever appear in a tweet (our own site). empty = no links at all
# production: imkumoagent.com
TWITTER_ALLOWED_LINK_HOSTS=

# limits + cadence
TWITTER_MAX_TWEETS_PER_DAY=30
TWITTER_MAX_REPLIES_PER_DAY=20
TWITTER_MAX_REPLIES_PER_USER_HOUR=1
TWITTER_MENTIONS_POLL_MS=120000
TWITTER_HEARTBEAT_MS=14400000
TWITTER_EVENT_COOLDOWN_MS=900000
